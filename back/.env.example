# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
TOKEN_SECRET=change_me_to_a_long_random_secret
TOKEN_DURATION=48h

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASS=pass
DB_NAME=name

# File storage. Local storage is the currently supported upload adapter.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./storage

# Shared variables used by optional external providers.
FILE_PUBLIC_BASE_URL=
FILE_BUCKET=
FILE_REGION=
FILE_PROJECT_ID=
FILE_ACCESS_KEY=
FILE_SECRET=
FILE_CREDENTIALS=
FILE_DRIVE_FOLDER_ID=
FILE_CLIENT_ID=
FILE_CLIENT_SECRET=
FILE_TENANT_ID=
