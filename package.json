{
  "name": "congr.io",
  "version": "0.0.13",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "back",
    "front"
  ],
  "scripts": {
    "dev": "concurrently \"yarn start:back\" \"yarn wait-and-front\"",
    "start:back": "yarn --cwd back start:dev",
    "wait-and-front": "wait-on tcp:4000 && yarn --cwd front dev --host",
    "lint": "yarn workspaces run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md,html}\" --ignore-path .gitignore",
    "format:staged": "node scripts/format-staged.mjs",
    "bump:versions": "node scripts/bump-package-versions.mjs",
    "commitmsg:check": "node scripts/commitmsg-check.mjs",
    "i18n:check": "node scripts/i18n.mjs",
    "features:check": "node scripts/features.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "wait-on": "^9.0.3"
  }
}
