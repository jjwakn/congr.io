{
  "name": "congr.io",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "back",
    "front"
  ],
  "scripts": {
    "dev": "concurrently \"yarn start:back\" \"yarn wait-and-front\"",
    "start:back": "yarn --cwd back start:dev",
    "wait-and-front": "wait-on tcp:4000 && yarn --cwd front dev --host",
    "lint": "yarn workspaces run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md,html}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "wait-on": "^8.0.4"
  }
}
